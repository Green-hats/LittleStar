<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="sprout_cloud">#F6F8FC</color>
    <color name="sprout_blue">#305EC4</color>
    <color name="sprout_sky">#E4EEFF</color>
    <color name="sprout_navy">#182D49</color>
    <color name="sprout_steel">#3B577B</color>
    <color name="sprout_mist">#E6EDF6</color>
    <color name="sprout_muted">#52647A</color>
    <color name="sprout_line">#D4DFED</color>
    <color name="sprout_track">#BED0EA</color>
    <color name="sprout_fern">#146550</color>
    <color name="sprout_dew">#D8F4E9</color>
    <color name="sprout_sun">#FFCB66</color>
    <color name="sprout_outline">#708199</color>
    <color name="sprout_rose">#FCE6E9</color>
    <color name="sprout_on_rose">#823144</color>

    <style name="Widget.Sprout.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Sprout.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Sprout.Back" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Sprout.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Sprout.Card.Hero">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="TextAppearance.Sprout.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Sprout.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Sprout.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <dimen name="sprout_gutter">20dp</dimen>
    <dimen name="sprout_space">12dp</dimen>

    <string name="sprout_learn">Learn</string>
    <string name="sprout_parents">Parents</string>
    <string name="sprout_today">Today’s adventure</string>
    <string name="sprout_today_goal">%1$d of %2$d words learned</string>
    <string name="sprout_today_loading">Getting your lesson ready…</string>
    <string name="sprout_path">Your lesson path</string>
    <string name="sprout_path_meet">1 · Meet</string>
    <string name="sprout_path_play">2 · Practice</string>
    <string name="sprout_path_done">3 · Finish</string>
    <string name="sprout_start">Start lesson</string>
    <string name="sprout_continue">Continue lesson</string>
    <string name="sprout_review">Review words</string>
    <string name="sprout_explore">Explore more</string>
    <string name="sprout_words">Words</string>
    <string name="sprout_culture">Culture</string>
    <string name="sprout_back">Back</string>
</resources>
