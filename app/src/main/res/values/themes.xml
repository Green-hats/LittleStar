<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LittleStar" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/sprout_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/sprout_sky</item>
        <item name="colorOnPrimaryContainer">@color/sprout_navy</item>
        <item name="colorSecondary">@color/sprout_steel</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@color/sprout_mist</item>
        <item name="colorOnSecondaryContainer">@color/sprout_steel</item>
        <item name="colorTertiary">@color/sprout_fern</item>
        <item name="colorOnTertiary">@android:color/white</item>
        <item name="colorTertiaryContainer">@color/sprout_dew</item>
        <item name="colorOnTertiaryContainer">@color/sprout_fern</item>
        <item name="colorSurface">@color/ls_card</item>
        <item name="colorOnSurface">@color/sprout_navy</item>
        <item name="colorSurfaceVariant">@color/sprout_mist</item>
        <item name="colorSurfaceContainer">@color/sprout_cloud</item>
        <item name="colorSurfaceContainerHigh">@color/sprout_mist</item>
        <item name="colorSurfaceContainerHighest">@color/sprout_line</item>
        <item name="colorOnSurfaceVariant">@color/sprout_muted</item>
        <item name="colorOutline">@color/sprout_outline</item>
        <item name="colorOutlineVariant">@color/sprout_line</item>
        <item name="colorError">@color/sprout_on_rose</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorErrorContainer">@color/sprout_rose</item>
        <item name="colorOnErrorContainer">@color/sprout_on_rose</item>
        <item name="android:colorBackground">@color/sprout_cloud</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="lsStroke">@color/ls_stroke</item>
        <item name="lsShadow">@color/ls_shadow</item>
        <item name="blockLayoutStyle">@style/Widget.LS.Block</item>
    </style>

    <!-- 孩子区：纸白底，锁定竖屏在 manifest 里做 -->
    <style name="Theme.LittleStar.Child" parent="Theme.LittleStar" />

    <!-- 家长区：同一套色板，组件用 M3 -->
    <style name="Theme.LittleStar.Parent" parent="Theme.LittleStar" />

    <!-- 启动画面 -->
    <style name="Theme.LittleStar.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="windowSplashScreenBackground">@color/sprout_cloud</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_panda</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/sprout_sky</item>
        <item name="postSplashScreenTheme">@style/Theme.LittleStar.Child</item>
    </style>
</resources>
