<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LittleStar" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/ls_primary</item>
        <item name="colorOnPrimary">@color/ls_on_primary</item>
        <item name="colorPrimaryContainer">@color/ls_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ls_on_primary_container</item>
        <item name="colorSecondary">@color/ls_secondary</item>
        <item name="colorOnSecondary">@color/ls_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ls_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ls_on_secondary_container</item>
        <item name="colorTertiary">@color/ls_tertiary</item>
        <item name="colorOnTertiary">@color/ls_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ls_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ls_on_tertiary_container</item>
        <item name="colorSurface">@color/ls_paper</item>
        <item name="colorSurfaceVariant">@color/ls_surface_variant</item>
        <item name="colorSurfaceContainer">@color/ls_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/ls_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/ls_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/ls_surface_dim</item>
        <item name="colorSurfaceBright">@color/ls_paper</item>
        <item name="colorSurfaceContainerLowest">@color/ls_card</item>
        <item name="colorSurfaceContainerLow">@color/ls_surface_container_low</item>
        <item name="colorSurfaceInverse">@color/ls_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/ls_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/ls_inverse_primary</item>
        <item name="colorOnSurface">@color/ls_ink</item>
        <item name="colorOnSurfaceVariant">@color/ls_muted</item>
        <item name="colorOutline">@color/ls_outline</item>
        <item name="colorOutlineVariant">@color/ls_outline_variant</item>
        <item name="colorError">@color/ls_error</item>
        <item name="colorOnError">@color/ls_card</item>
        <item name="colorErrorContainer">@color/ls_clay</item>
        <item name="colorOnErrorContainer">@color/ls_on_clay</item>
        <item name="android:colorBackground">@color/ls_paper</item>
        <item name="colorOnBackground">@color/ls_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="blockLayoutStyle">@style/Widget.LS.Block</item>
    </style>

    <!-- 孩子区：纸白底，锁定竖屏在 manifest 里做 -->
    <style name="Theme.LittleStar.Child" parent="Theme.LittleStar" />

    <!-- 家长区：同一套色板，组件用 M3 -->
    <style name="Theme.LittleStar.Parent" parent="Theme.LittleStar" />

    <!-- 启动画面 -->
    <style name="Theme.LittleStar.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="windowSplashScreenBackground">@color/ls_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_panda</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ls_yellow</item>
        <item name="postSplashScreenTheme">@style/Theme.LittleStar.Child</item>
    </style>
</resources>
