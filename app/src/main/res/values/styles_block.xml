<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.LS.Block" parent="">
        <item name="ls_fill">?attr/colorSurface</item>
        <item name="ls_strokeColor">?attr/colorOutlineVariant</item>
        <item name="ls_strokeWidth">@dimen/ls_surface_stroke</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_tile</item>
    </style>

    <style name="Widget.LS.Block.Primary">
        <item name="ls_fill">@color/primary_fill</item>
        <item name="ls_strokeWidth">@dimen/ls_no_stroke</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_pill</item>
        <item name="ls_rippleColor">@color/ls_ripple_on_fill</item>
    </style>

    <style name="Widget.LS.Block.Primary.Media">
        <item name="ls_fill">@color/secondary_fill</item>
    </style>

    <style name="Widget.LS.Block.Secondary">
        <item name="ls_strokeColor">?attr/colorOutline</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_pill</item>
    </style>

    <style name="Widget.LS.Block.Tonal">
        <item name="ls_fill">?attr/colorSecondaryContainer</item>
        <item name="ls_strokeWidth">@dimen/ls_no_stroke</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_pill</item>
    </style>

    <style name="Widget.LS.Block.Icon">
        <item name="ls_fill">?attr/colorSurfaceContainer</item>
        <item name="ls_strokeWidth">@dimen/ls_no_stroke</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_input</item>
    </style>

    <style name="Widget.LS.Block.Navigation" parent="Widget.LS.Block.Icon">
        <item name="ls_fill">@android:color/transparent</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_pill</item>
    </style>

    <style name="Widget.LS.Block.Surface">
        <item name="ls_cornerRadius">@dimen/ls_radius_hero</item>
        <item name="ls_pressable">false</item>
    </style>

    <style name="Widget.LS.Block.Hero" parent="Widget.LS.Block.Surface">
        <item name="ls_fill">?attr/colorPrimaryContainer</item>
        <item name="ls_strokeWidth">@dimen/ls_no_stroke</item>
    </style>

    <style name="Widget.LS.Block.Row">
        <item name="ls_fill">@android:color/transparent</item>
        <item name="ls_strokeWidth">@dimen/ls_no_stroke</item>
        <item name="ls_cornerRadius">@dimen/ls_radius_input</item>
    </style>

    <style name="Widget.LS.Block.Tile" />

    <style name="Widget.LS.Block.Option">
        <item name="ls_strokeColor">?attr/colorOutline</item>
    </style>
</resources>
