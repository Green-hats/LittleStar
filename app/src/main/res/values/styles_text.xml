<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 教学汉字：子集字体，zh-CN 保证中文字形 -->
    <style name="TextAppearance.LS.HanziHero" parent="">
        <item name="fontFamily">@font/noto_sans_sc_hanzi</item>
        <item name="android:textSize">100sp</item>
        <item name="android:textLocale">zh-CN</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ls_ink</item>
    </style>

    <style name="TextAppearance.LS.HanziTile" parent="">
        <item name="fontFamily">@font/noto_sans_sc_hanzi</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textLocale">zh-CN</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ls_ink</item>
    </style>

    <style name="TextAppearance.LS.HanziOption" parent="">
        <item name="fontFamily">@font/noto_sans_sc_hanzi</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textLocale">zh-CN</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ls_ink</item>
    </style>

    <style name="TextAppearance.LS.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.LS.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.LS.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.LS.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.LS.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.LS.HomeLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.LS.HomeProgress" parent="TextAppearance.LS.Title">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:textSize">@dimen/ls_home_progress_text</item>
    </style>

    <style name="TextAppearance.LS.Pinyin" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="fontFamily">@font/littlestar_latin</item>
    </style>

    <style name="TextAppearance.LS.Pinyin.Small" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="fontFamily">@font/littlestar_latin</item>
    </style>

    <style name="TextAppearance.LS.English" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.LS.English.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.LS.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
    <style name="Widget.LS.Label.Control" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">@dimen/ls_control_label_min</item>
        <item name="android:autoSizeMaxTextSize">@dimen/ls_control_label_max</item>
        <item name="android:autoSizeStepGranularity">@dimen/ls_text_fit_step</item>
    </style>

    <style name="Widget.LS.Glyph.Decorative" parent="Widget.LS.Label.Control">
        <item name="android:autoSizeMaxTextSize">@dimen/ls_decorative_glyph_max</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
