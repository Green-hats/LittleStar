<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wordListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/sprout_gutter"
    android:paddingEnd="@dimen/sprout_gutter"
    android:paddingVertical="12dp"
    android:background="@color/sprout_cloud">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Back"
            android:text="@string/sprout_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/listTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Title"
            android:text="@string/sprout_words"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:accessibilityHeading="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/listProgressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Sprout.Caption"
        android:text="@string/sprout_today_loading" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/listProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="@color/sprout_track"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        android:layout_marginTop="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wordGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Sprout.Button"
        android:text="@string/sprout_theme_practice"
        app:icon="@drawable/ic_quiz"
        android:enabled="false" />
</LinearLayout>
