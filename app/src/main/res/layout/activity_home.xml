<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ls_paper">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeRoot" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/ls_margin">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="@dimen/ls_avatar" android:layout_height="@dimen/ls_avatar"
                    android:importantForAccessibility="no" android:src="@drawable/ic_panda" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="@dimen/ls_gap"
                    android:text="@string/app_name" android:textAppearance="@style/TextAppearance.LS.Title" />
            </LinearLayout>
            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/heroCard" style="@style/Widget.LS.Block.Surface"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/ls_gap">
                    <TextView android:id="@+id/todayLabel" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/home_today_words"
                        android:textAppearance="@style/TextAppearance.LS.Body" android:textStyle="bold" />
                    <com.littlestar.app.core.ui.HanziTextView android:id="@+id/heroHanzi"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.HanziHero" />
                    <TextView android:id="@+id/heroPinyin" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.Pinyin" />
                    <TextView android:id="@+id/heroEnglish" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.English" />
                    <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnListen"
                        style="@style/Widget.LS.Block.Icon" android:layout_width="@dimen/ls_btn_icon"
                        android:layout_height="@dimen/ls_btn_icon" android:layout_marginTop="@dimen/ls_gap"
                        android:contentDescription="@string/home_listen_desc" app:ls_fill="@color/ls_yellow">
                        <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon"
                            android:layout_gravity="center" android:importantForAccessibility="no"
                            android:src="@drawable/ic_speaker" app:tint="@color/ls_on_yellow" />
                    </com.littlestar.app.core.ui.BlockLayout>
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnStart"
                style="@style/Widget.LS.Block.Primary" android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_primary" android:layout_marginTop="@dimen/ls_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="@dimen/ls_gap">
                    <ImageView android:id="@+id/btnStartIcon" android:layout_width="@dimen/ls_icon"
                        android:layout_height="@dimen/ls_icon" android:importantForAccessibility="no"
                        android:src="@drawable/ic_play" app:tint="@color/ls_on_red" />
                    <TextView android:id="@+id/btnStartText" style="@style/Widget.LS.Label.Navigation"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginStart="@dimen/ls_gap" android:gravity="center"
                        android:text="@string/home_start" android:textAppearance="@style/TextAppearance.LS.Button" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
            <TextView android:id="@+id/todayProgressText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap"
                android:textAppearance="@style/TextAppearance.LS.Caption" />
            <com.littlestar.app.core.ui.SegmentProgressView android:id="@+id/todayProgress"
                android:layout_width="match_parent" android:layout_height="@dimen/ls_seg_height"
                android:layout_marginTop="@dimen/ls_gap_sm" />
            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/moduleWords"
                style="@style/Widget.LS.Block.Module" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_section">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/ls_module_height" android:padding="@dimen/ls_gap"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/moduleWordsIcon" android:layout_width="@dimen/ls_btn_icon"
                        android:layout_height="@dimen/ls_btn_icon" android:importantForAccessibility="no"
                        android:src="@drawable/ic_book" app:tint="@color/ls_red" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginHorizontal="@dimen/ls_gap" android:orientation="vertical">
                        <TextView android:id="@+id/moduleWordsTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/home_module_words_title"
                            android:textAppearance="@style/TextAppearance.LS.Title" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/home_module_words_sub" android:textAppearance="@style/TextAppearance.LS.Body" />
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon"
                        android:importantForAccessibility="no" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/moduleCulture"
                style="@style/Widget.LS.Block.Module" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/ls_module_height" android:padding="@dimen/ls_gap"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/moduleCultureIcon" android:layout_width="@dimen/ls_btn_icon"
                        android:layout_height="@dimen/ls_btn_icon" android:importantForAccessibility="no"
                        android:src="@drawable/ic_music" app:tint="@color/ls_blue" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginHorizontal="@dimen/ls_gap" android:orientation="vertical">
                        <TextView android:id="@+id/moduleCultureTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/home_module_culture_title"
                            android:textAppearance="@style/TextAppearance.LS.Title" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/home_module_culture_sub" android:textAppearance="@style/TextAppearance.LS.Body" />
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon"
                        android:importantForAccessibility="no" android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/parentEntry"
                style="@style/Widget.LS.Block.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/ls_btn_secondary"
                android:layout_marginTop="@dimen/ls_parent_entry_top">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="@dimen/ls_gap" android:gravity="center" android:text="@string/home_parent_entry"
                    android:textAppearance="@style/TextAppearance.LS.Body" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include android:id="@+id/onboarding" layout="@layout/view_onboarding"
        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>
