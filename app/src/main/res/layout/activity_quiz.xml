<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/sprout_cloud">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sprout_gutter"
        android:paddingEnd="@dimen/sprout_gutter"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Sprout.Back"
                android:text="@string/sprout_back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sprout.Title"
                android:text="@string/sprout_practice"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/quizCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Caption"
            android:text="@string/sprout_today_loading" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/quizProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/sprout_fern"
            app:trackColor="@color/sprout_dew"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            android:layout_marginTop="12dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/questionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:text="@string/sprout_choose" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Secondary"
                    android:layout_marginTop="8dp"
                    android:text="@string/sprout_listen_again"
                    app:icon="@drawable/ic_speaker" />

                <LinearLayout
                    android:id="@+id/shapeClue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/clueShape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:textColor="@color/sprout_on_lilac"
                        android:textSize="32sp" />
                    <TextView
                        android:id="@+id/clueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.Sprout.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/audioMissing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card"
            app:cardBackgroundColor="@color/sprout_peach"
            android:visibility="gone"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:text="@string/pr_audio_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudioRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Secondary"
                    android:text="@string/sprout_listen"
                    app:icon="@drawable/ic_speaker" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudioContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Back"
                    android:text="@string/sprout_back" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <LinearLayout
            android:id="@+id/quizOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <include
                    android:id="@+id/option0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/view_quiz_option"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/option1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/view_quiz_option"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <include
                    android:id="@+id/option2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/view_quiz_option"
                    android:layout_margin="4dp" />

                <include
                    android:id="@+id/option3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/view_quiz_option"
                    android:layout_margin="4dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card"
            android:visibility="gone"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/feedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:accessibilityLiveRegion="polite" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Button"
                    android:text="@string/sprout_try_again"
                    app:icon="@drawable/ic_next"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Button"
                    android:text="@string/sprout_next"
                    app:icon="@drawable/ic_next"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
