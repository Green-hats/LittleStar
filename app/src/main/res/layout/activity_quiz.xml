<?xml version='1.0' encoding='utf-8'?>
<!-- §7.5 测验：ConstraintLayout 响应式布局，顶栏 + 进度段 + 题目卡（插图 + 听）+ 2×2 约束链选项 + 答后反馈条 + NEXT -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/quizRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_paper">

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/quizContent" android:layout_width="0dp" android:layout_height="0dp" android:padding="@dimen/ls_margin" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/ls_content_max_width">

        <!-- 顶栏 -->
        <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnBack" style="@style/Widget.LS.Block.Icon" android:layout_width="@dimen/ls_btn_icon" android:layout_height="@dimen/ls_btn_icon" android:contentDescription="@string/nav_back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

            <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_back"/>
        </com.littlestar.app.core.ui.BlockLayout>

        <TextView android:id="@+id/quizTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_gap" android:layout_marginEnd="@dimen/ls_gap" android:text="@string/quiz_title" android:textAppearance="@style/TextAppearance.LS.Title" app:layout_constraintBottom_toBottomOf="@id/btnBack" app:layout_constraintEnd_toStartOf="@id/quizCounter" app:layout_constraintStart_toEndOf="@id/btnBack" app:layout_constraintTop_toTopOf="@id/btnBack"/>

        <TextView android:id="@+id/quizCounter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.Title" android:textColor="@color/ls_muted" app:layout_constraintBottom_toBottomOf="@id/btnBack" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/btnBack"/>

        <com.littlestar.app.core.ui.SegmentProgressView android:id="@+id/quizProgress" android:layout_width="0dp" android:layout_height="@dimen/ls_seg_height" android:layout_marginTop="@dimen/ls_gap" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnBack"/>

        <!-- 题目卡 -->
        <com.littlestar.app.core.ui.BlockLayout android:id="@+id/questionCard" style="@style/Widget.LS.Block.Hero" android:layout_width="0dp" android:layout_height="@dimen/ls_quiz_card_height" android:layout_marginTop="@dimen/ls_gap" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/quizProgress">

            <FrameLayout android:layout_width="@dimen/ls_quiz_prompt_ill" android:layout_height="@dimen/ls_quiz_prompt_ill" android:layout_gravity="center_horizontal|top" android:layout_marginTop="@dimen/ls_gap">

                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ill_placeholder"/>

                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:importantForAccessibility="no" android:padding="@dimen/ls_quiz_icon_padding" android:src="@drawable/ic_quiz" app:tint="@color/ls_on_yellow"/>
            </FrameLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="@dimen/ls_card_pad" android:layout_marginBottom="@dimen/ls_card_pad" android:text="@string/quiz_listen_hint" android:textAppearance="@style/TextAppearance.LS.Caption"/>

            <!-- 蓝色听块 -->
            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnListen" style="@style/Widget.LS.Block.Icon" android:layout_width="@dimen/ls_listen_block" android:layout_height="@dimen/ls_listen_block" android:layout_gravity="bottom|end" android:layout_marginEnd="@dimen/ls_card_pad" android:layout_marginBottom="@dimen/ls_quiz_listen_bottom" android:contentDescription="@string/home_listen_desc" app:ls_fill="@color/ls_blue">

                <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_speaker" app:tint="@color/ls_on_blue"/>
            </com.littlestar.app.core.ui.BlockLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <!-- 英文提示：默认隐藏（settings.isEnglishHint） -->
        <TextView android:id="@+id/englishHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap_sm" android:gravity="center" android:textAppearance="@style/TextAppearance.LS.English" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/questionCard"/>

        <!-- 选项 2×2 ConstraintLayout 约束链 -->
        <include android:id="@+id/option0" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="@dimen/ls_gap" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" app:layout_constraintBottom_toTopOf="@id/option2" app:layout_constraintEnd_toStartOf="@id/option1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/englishHint"/>

        <include android:id="@+id/option1" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="6dp" app:layout_constraintBottom_toBottomOf="@id/option0" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/option0" app:layout_constraintTop_toTopOf="@id/option0"/>

        <include android:id="@+id/option2" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" app:layout_constraintBottom_toTopOf="@id/bottomFeedback" app:layout_constraintEnd_toStartOf="@id/option3" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/option0"/>

        <include android:id="@+id/option3" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="6dp" app:layout_constraintBottom_toBottomOf="@id/option2" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/option2" app:layout_constraintTop_toTopOf="@id/option2"/>

        <!-- 反馈条 + NEXT（答后从下方滑入） -->
        <LinearLayout android:id="@+id/bottomFeedback" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">

            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/feedbackBar" style="@style/Widget.LS.Block.Icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" app:ls_fill="@color/ls_mint" app:ls_pressable="false" android:minHeight="@dimen/ls_feedback_height">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/ls_gap" android:paddingEnd="@dimen/ls_gap" android:minHeight="@dimen/ls_feedback_height" android:paddingTop="@dimen/ls_gap_sm" android:paddingBottom="@dimen/ls_gap_sm">

                    <ImageView android:id="@+id/feedbackIcon" android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:importantForAccessibility="no" android:src="@drawable/ic_check"/>

                    <TextView android:id="@+id/feedbackText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_gap" android:textAppearance="@style/TextAppearance.LS.Body" android:textStyle="bold" android:layout_weight="1" android:textSize="@dimen/ls_quiz_feedback_text" android:accessibilityLiveRegion="polite"/>
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnNext" style="@style/Widget.LS.Block.Primary" android:layout_width="match_parent" android:layout_height="@dimen/ls_btn_primary" android:layout_marginTop="@dimen/ls_gap">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal">

                    <TextView android:id="@+id/btnNextText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quiz_next" android:textAppearance="@style/TextAppearance.LS.Button"/>

                    <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:layout_marginStart="@dimen/ls_gap_sm" android:importantForAccessibility="no" android:src="@drawable/ic_chevron" app:tint="@color/ls_on_red"/>
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
<FrameLayout android:id="@+id/audioMissing" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:clickable="true" android:focusable="true">

        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_ink_scrim"/>

        <com.littlestar.app.core.ui.BlockLayout style="@style/Widget.LS.Block.Secondary" android:layout_width="@dimen/ls_ob_dialog_width" android:layout_height="wrap_content" android:layout_gravity="center" app:ls_pressable="false">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/ls_card_pad">

                <ImageView android:layout_width="@dimen/ls_btn_icon" android:layout_height="@dimen/ls_btn_icon" android:importantForAccessibility="no" android:src="@drawable/ic_speaker" app:tint="@color/ls_muted"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" android:text="@string/pr_audio_title" android:textAppearance="@style/TextAppearance.LS.Title"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap_sm" android:text="@string/pr_audio_message" android:textAppearance="@style/TextAppearance.LS.Caption" android:textSize="14sp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" android:orientation="horizontal">

                    <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnAudioContinue" style="@style/Widget.LS.Block.Option" android:layout_width="0dp" android:layout_height="@dimen/ls_btn_icon" android:layout_weight="1">

                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/pr_audio_leave_quiz" android:textAppearance="@style/TextAppearance.LS.Body" android:id="@+id/audioContinueLabel"/>
                    </com.littlestar.app.core.ui.BlockLayout>

                    <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnAudioRetry" style="@style/Widget.LS.Block.Option" android:layout_width="0dp" android:layout_height="@dimen/ls_btn_icon" android:layout_marginStart="@dimen/ls_gap" android:layout_weight="1">

                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/pr_audio_retry" android:textAppearance="@style/TextAppearance.LS.Body"/>
                    </com.littlestar.app.core.ui.BlockLayout>
                </LinearLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
