<?xml version="1.0" encoding="utf-8"?>
<!-- §7.5 测验：顶栏 + 进度段 + 题目卡（插图 + 听）+ 2×2 选项 + 答后反馈条 + NEXT -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:text="@string/quiz_title"
                android:textAppearance="@style/TextAppearance.LS.Title" />

            <TextView
                android:id="@+id/quizCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LS.Title"
                android:textColor="@color/ls_muted" />
        </LinearLayout>

        <com.littlestar.app.core.ui.SegmentProgressView
            android:id="@+id/quizProgress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_seg_height"
            android:layout_marginTop="@dimen/ls_gap" />

        <!-- 题目卡 -->
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/questionCard"
            style="@style/Widget.LS.Block.Hero"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_quiz_card_height"
            android:layout_marginTop="@dimen/ls_gap">

            <FrameLayout
                android:layout_width="@dimen/ls_ill_large"
                android:layout_height="@dimen/ls_ill_large"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="@dimen/ls_gap">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ill_placeholder" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/ls_section_lg"
                    android:src="@drawable/ic_quiz"
                    app:tint="@color/ls_on_yellow" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/ls_card_pad"
                android:layout_marginBottom="@dimen/ls_card_pad"
                android:text="@string/quiz_listen_hint"
                android:textAppearance="@style/TextAppearance.LS.Caption" />

            <!-- 蓝色听块 -->
            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnListen"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_listen_block"
                android:layout_height="@dimen/ls_listen_block"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/ls_card_pad"
                android:layout_marginBottom="@dimen/ls_card_pad"
                android:contentDescription="@string/home_listen_desc"
                app:ls_fill="@color/ls_blue">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/ls_on_blue" />
            </com.littlestar.app.core.ui.BlockLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <!-- 英文提示：默认隐藏（settings.isEnglishHint） -->
        <TextView
            android:id="@+id/englishHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.LS.English"
            android:visibility="gone" />

        <!-- 选项 2×2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ls_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    android:id="@+id/option0"
                    layout="@layout/view_quiz_option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/option1"
                    layout="@layout/view_quiz_option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/ls_gap"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    android:id="@+id/option2"
                    layout="@layout/view_quiz_option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/option3"
                    layout="@layout/view_quiz_option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 反馈条 + NEXT（答后从下方滑入） -->
        <LinearLayout
            android:id="@+id/bottomFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/feedbackBar"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_feedback_height"
                android:layout_marginTop="@dimen/ls_gap"
                app:ls_fill="@color/ls_mint"
                app:ls_pressable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ls_gap"
                    android:paddingEnd="@dimen/ls_gap">

                    <ImageView
                        android:id="@+id/feedbackIcon"
                        android:layout_width="@dimen/ls_icon"
                        android:layout_height="@dimen/ls_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:id="@+id/feedbackText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ls_gap"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnNext"
                style="@style/Widget.LS.Block.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginTop="@dimen/ls_gap">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnNextText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quiz_next"
                        android:textAppearance="@style/TextAppearance.LS.Button" />

                    <ImageView
                        android:layout_width="@dimen/ls_icon"
                        android:layout_height="@dimen/ls_icon"
                        android:layout_marginStart="@dimen/ls_gap_sm"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/ls_on_red" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
