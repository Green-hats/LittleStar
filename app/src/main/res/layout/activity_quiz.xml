<?xml version='1.0' encoding='utf-8'?>
<!-- §7.5 测验：ConstraintLayout 响应式布局，顶栏 + 进度段 + 题目卡（插图 + 听）+ 2×2 约束链选项 + 答后反馈条 + NEXT -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/quizRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_paper">

    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/ls_content_max_width">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/quizContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/ls_btn_icon"
            android:layout_height="@dimen/ls_btn_icon"
            android:contentDescription="@string/nav_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:icon="@drawable/ic_back" />

        <TextView android:id="@+id/quizTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_gap" android:layout_marginEnd="@dimen/ls_gap" android:text="@string/quiz_title" android:textAppearance="@style/TextAppearance.LS.Title" app:layout_constraintBottom_toBottomOf="@id/btnBack" app:layout_constraintEnd_toStartOf="@id/quizCounter" app:layout_constraintStart_toEndOf="@id/btnBack" app:layout_constraintTop_toTopOf="@id/btnBack"/>

        <TextView android:id="@+id/quizCounter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.Title" android:textColor="@color/ls_muted" app:layout_constraintBottom_toBottomOf="@id/btnBack" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/btnBack"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/quizProgress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnBack"/>

        <com.google.android.material.card.MaterialCardView android:id="@+id/questionCard" style="@style/Widget.LS.Card.Story"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quizProgress"
            app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="@dimen/ls_card_pad" android:orientation="vertical">
                <FrameLayout android:id="@+id/questionIllustration" android:layout_width="@dimen/ls_quiz_prompt_ill"
                    android:layout_height="@dimen/ls_quiz_prompt_ill" android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_home_icon" android:backgroundTint="@color/ls_card">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:importantForAccessibility="no" android:padding="@dimen/ls_quiz_icon_padding"
                        android:src="@drawable/ic_quiz" app:tint="@color/ls_primary" />
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/questionHint" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginEnd="@dimen/ls_gap"
                        android:text="@string/quiz_listen_hint" android:textAppearance="@style/TextAppearance.LS.Title" />
                    <com.littlestar.app.core.ui.LearningButton
                        android:id="@+id/btnListen"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="@dimen/ls_listen_block"
                        android:layout_height="@dimen/ls_listen_block"
                        android:contentDescription="@string/home_listen_desc"
                        app:icon="@drawable/ic_speaker" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 英文提示：默认隐藏（settings.isEnglishHint） -->
        <TextView android:id="@+id/englishHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap_sm" android:gravity="center" android:textAppearance="@style/TextAppearance.LS.English" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/questionCard"/>

        <!-- 选项 2×2 ConstraintLayout 约束链 -->
        <include android:id="@+id/option0" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" app:layout_constraintBottom_toTopOf="@id/option2" app:layout_constraintEnd_toStartOf="@id/option1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/englishHint"/>

        <include android:id="@+id/option1" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" app:layout_constraintBottom_toBottomOf="@id/option0" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/option0" app:layout_constraintTop_toTopOf="@id/option0"/>

        <include android:id="@+id/option2" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" app:layout_constraintBottom_toTopOf="@id/bottomFeedback" app:layout_constraintEnd_toStartOf="@id/option3" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/option0"/>

        <include android:id="@+id/option3" layout="@layout/view_quiz_option" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" app:layout_constraintBottom_toBottomOf="@id/option2" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/option2" app:layout_constraintTop_toTopOf="@id/option2"/>

        <!-- 反馈条 + NEXT（答后从下方滑入） -->
        <LinearLayout android:id="@+id/bottomFeedback" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">

            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/feedbackBar" style="@style/Widget.LS.Block.Icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" app:ls_fill="@color/ls_mint" app:ls_pressable="false" android:minHeight="@dimen/ls_feedback_height">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/ls_gap" android:paddingEnd="@dimen/ls_gap" android:minHeight="@dimen/ls_feedback_height" android:paddingTop="@dimen/ls_gap_sm" android:paddingBottom="@dimen/ls_gap_sm">

                    <ImageView android:id="@+id/feedbackIcon" android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:importantForAccessibility="no" android:src="@drawable/ic_check"/>

                    <TextView android:id="@+id/feedbackText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_gap" android:textAppearance="@style/TextAppearance.LS.Body" android:textStyle="bold" android:layout_weight="1" android:textSize="@dimen/ls_quiz_feedback_text" android:accessibilityLiveRegion="polite"/>
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ls_btn_icon"
                android:layout_marginTop="@dimen/ls_gap_sm"
                android:visibility="gone"
                android:text="@string/quiz_retry" />
            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ls_btn_icon"
                android:layout_marginTop="@dimen/ls_gap_sm"
                android:text="@string/quiz_next" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
<FrameLayout android:id="@+id/audioMissing" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:clickable="true" android:focusable="true">

        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_ink_scrim"/>

        <com.littlestar.app.core.ui.BlockLayout style="@style/Widget.LS.Block.Secondary" android:layout_width="@dimen/ls_ob_dialog_width" android:layout_height="wrap_content" android:layout_gravity="center" app:ls_pressable="false">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/ls_card_pad">

                <ImageView android:layout_width="@dimen/ls_btn_icon" android:layout_height="@dimen/ls_btn_icon" android:importantForAccessibility="no" android:src="@drawable/ic_speaker" app:tint="@color/ls_muted"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" android:text="@string/pr_audio_title" android:textAppearance="@style/TextAppearance.LS.Title"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap_sm" android:text="@string/pr_audio_message" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"/>

                <com.littlestar.app.core.ui.LearningButton
                    android:id="@+id/btnAudioRetry"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:minHeight="@dimen/ls_btn_icon"
                    android:text="@string/pr_audio_retry" />

                <com.littlestar.app.core.ui.LearningButton
                    android:id="@+id/btnAudioContinue"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ls_btn_icon"
                    android:text="@string/pr_audio_leave_quiz" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
