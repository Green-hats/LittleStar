<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReplayWord"
        style="@style/Widget.Sprout.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/noto_sans_sc_hanzi"
        android:textLocale="zh-CN"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="@dimen/ls_quiz_option_text"
        app:icon="@drawable/ic_speaker"
        app:iconGravity="textStart" />

    <TextView
        android:id="@+id/practicedResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sprout_space"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Sprout.Caption" />
</LinearLayout>
