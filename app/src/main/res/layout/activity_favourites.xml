<?xml version="1.0" encoding="utf-8"?>
<!-- §7.10 收藏：有内容列表 + Sort；空状态 = 黄舞台 + 睡熊猫 + 出口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/favouritesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:text="@string/fav_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />

            <TextView
                android:id="@+id/btnSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/ls_gap_sm"
                android:text="@string/fav_sort_new"
                android:textAppearance="@style/TextAppearance.LS.Body"
                android:textColor="@color/ls_blue" />
        </LinearLayout>

        <TextView
            android:id="@+id/favCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ls_gap"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.littlestar.app.core.ui.BlockLayout
                style="@style/Widget.LS.Block.Hero"
                android:layout_width="@dimen/ls_reward_stage"
                android:layout_height="@dimen/ls_reward_stage"
                app:ls_fill="@color/ls_yellow"
                app:ls_pressable="false">

                <ImageView
                    android:layout_width="@dimen/ls_reward_panda"
                    android:layout_height="@dimen/ls_reward_panda"
                    android:layout_gravity="center"
                    android:contentDescription="@string/home_panda_desc"
                    android:src="@drawable/ic_panda_sleep" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_section"
                android:text="@string/fav_empty_title"
                android:textAppearance="@style/TextAppearance.LS.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_gap_sm"
                android:text="@string/fav_empty_sub"
                android:textAppearance="@style/TextAppearance.LS.Caption"
                android:textSize="14sp" />

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnGoListen"
                style="@style/Widget.LS.Block.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginTop="@dimen/ls_section_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/fav_empty_cta"
                    android:textAppearance="@style/TextAppearance.LS.Button" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
