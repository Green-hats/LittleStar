<?xml version="1.0" encoding="utf-8"?>
<!-- §7.16 学习记录：汇总卡 + 按天列表 + Sort；空态睡熊猫；底部隐私说明 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recordsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:text="@string/pr_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />

            <TextView
                android:id="@+id/btnSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/ls_gap_sm"
                android:text="@string/fav_sort_new"
                android:textAppearance="@style/TextAppearance.LS.Body"
                android:textColor="@color/ls_blue" />
        </LinearLayout>

        <!-- 汇总卡 -->
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/summaryCard"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            app:ls_pressable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ls_gap">

                <TextView
                    android:id="@+id/weekSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weekCompare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Caption" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recordsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ls_gap"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.littlestar.app.core.ui.BlockLayout
                style="@style/Widget.LS.Block.Hero"
                android:layout_width="@dimen/ls_reward_stage"
                android:layout_height="@dimen/ls_reward_stage"
                app:ls_fill="@color/ls_yellow"
                app:ls_pressable="false">

                <ImageView
                    android:layout_width="@dimen/ls_reward_panda"
                    android:layout_height="@dimen/ls_reward_panda"
                    android:layout_gravity="center"
                    android:contentDescription="@string/home_panda_desc"
                    android:src="@drawable/ic_panda_sleep" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_section"
                android:text="@string/pr_empty"
                android:textAppearance="@style/TextAppearance.LS.Headline" />

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnGoHome"
                style="@style/Widget.LS.Block.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginTop="@dimen/ls_section_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pr_empty_cta"
                    android:textAppearance="@style/TextAppearance.LS.Button" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/pr_privacy"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
    </LinearLayout>
</LinearLayout>
