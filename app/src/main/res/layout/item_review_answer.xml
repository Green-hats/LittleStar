<?xml version="1.0" encoding="utf-8"?>
<!-- A1 回顾行：汉字 + 拼音/英文 + 所选/正确答案 + 发音 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/answerRow"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ls_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ls_row_review"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ls_gap"
        android:paddingVertical="@dimen/ls_gap_sm">

        <com.littlestar.app.core.ui.HanziTextView
            android:id="@+id/rowHanzi"
            android:layout_width="@dimen/ls_cover"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="@dimen/ls_cover"
            android:textAppearance="@style/TextAppearance.LS.HanziTile"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ls_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowPinyin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LS.Pinyin.Small" />

            <TextView
                android:id="@+id/rowEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LS.English.Small" />

            <TextView
                android:id="@+id/rowAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.LS.Caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/rowStatus"
            android:layout_width="@dimen/ls_icon"
            android:layout_height="@dimen/ls_icon"
            android:layout_marginStart="@dimen/ls_gap_sm"
            android:contentDescription="@string/review_correct_desc" />

        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnSpeak"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="@dimen/ls_btn_icon"
            android:layout_height="@dimen/ls_btn_icon"
            android:layout_marginStart="@dimen/ls_gap_sm"
            android:contentDescription="@string/player_desc_play"
            app:icon="@drawable/ic_speaker" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
