<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/themeTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sprout_space"
    style="@style/Widget.Sprout.Card"
    app:cardBackgroundColor="@color/sprout_dew"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <FrameLayout
                android:id="@+id/badgeNum"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_sprout_step">
                <TextView
                    android:id="@+id/badgeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Caption"
                    android:gravity="center"
                    android:layout_gravity="center" />
            </FrameLayout>

            <ImageView
                android:id="@+id/badgeDone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="82dp">
            <com.littlestar.app.core.ui.HanziTextView
                android:id="@+id/themeGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="44sp"
                android:textColor="@color/sprout_on_lilac"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/themeIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/themeNameEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Section"
            android:gravity="center" />

        <com.littlestar.app.core.ui.HanziTextView
            android:id="@+id/themeNameZh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/sprout_on_lilac"
            android:gravity="center" />

        <TextView
            android:id="@+id/themeLearned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Caption"
            android:gravity="center" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
