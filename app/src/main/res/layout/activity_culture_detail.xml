<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cultureDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/sprout_gutter"
    android:paddingEnd="@dimen/sprout_gutter"
    android:paddingVertical="12dp"
    android:background="@color/sprout_cloud">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Back"
            android:text="@string/sprout_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Title"
            android:text="@string/culture_detail_title"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:accessibilityHeading="true" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/detailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sprout.Caption"
                android:text="@string/culture_detail_loading" />

            <LinearLayout
                android:id="@+id/detailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="146dp">
                            <com.littlestar.app.core.ui.HanziTextView
                                android:id="@+id/detailGlyph"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="44sp"
                                android:textColor="@color/sprout_on_lilac"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no" />

                            <ImageView
                                android:id="@+id/detailCover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:importantForAccessibility="no"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/detailTitleEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Sprout.Title"
                            android:accessibilityHeading="true" />

                        <com.littlestar.app.core.ui.HanziTextView
                            android:id="@+id/detailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textColor="@color/sprout_on_lilac" />

                        <TextView
                            android:id="@+id/detailSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Sprout.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:text="@string/sprout_about_piece" />

                <TextView
                    android:id="@+id/detailSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Caption" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Secondary"
                    android:text="@string/culture_detail_read_together"
                    app:icon="@drawable/ic_book" />

                <TextView
                    android:id="@+id/detailFocusHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:text="@string/culture_detail_focus"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Caption"
                    android:visibility="gone" />

                <com.littlestar.app.core.ui.HanziTextView
                    android:id="@+id/detailTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/sprout_on_lilac"
                    android:visibility="gone"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnListen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Sprout.Button"
        android:text="@string/sprout_play_piece"
        app:icon="@drawable/ic_play"
        android:enabled="false"
        android:layout_marginTop="8dp" />
</LinearLayout>
