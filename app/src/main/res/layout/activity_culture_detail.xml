<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cultureDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ls_margin"
        android:paddingEnd="@dimen/ls_margin"
        android:paddingTop="@dimen/ls_gap">
        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/ls_btn_icon"
            android:layout_height="@dimen/ls_btn_icon"
            android:contentDescription="@string/nav_back"
            app:icon="@drawable/ic_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ls_gap"
            android:layout_weight="1"
            android:text="@string/culture_detail_title"
            android:textAppearance="@style/TextAppearance.LS.Title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/ls_content_max_width"
            android:orientation="vertical"
            android:padding="@dimen/ls_margin">
            <TextView
                android:id="@+id/detailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/culture_detail_loading"
                android:textAppearance="@style/TextAppearance.LS.Body" />
            <LinearLayout
                android:id="@+id/detailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/ls_gap">
                        <ImageView
                            android:id="@+id/detailCover"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ls_detail_cover"
                            android:layout_marginBottom="@dimen/ls_gap_sm"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                        <com.littlestar.app.core.ui.HanziTextView
                            android:id="@+id/detailGlyph"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.LS.HanziTile"
                            android:textSize="@dimen/ls_detail_glyph"
                            android:textColor="@color/ls_green" />
                        <TextView
                            android:id="@+id/detailTitleEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.LS.Title" />
                        <TextView
                            android:id="@+id/detailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.LS.Body" />
                        <TextView
                            android:id="@+id/detailSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ls_gap_sm"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.LS.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/detailSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:textAppearance="@style/TextAppearance.LS.Body" />

                <com.littlestar.app.core.ui.LearningButton
                    android:id="@+id/btnPreview"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ls_btn_icon"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:text="@string/culture_detail_read_together" />
                <TextView
                    android:id="@+id/detailFocusHeading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:text="@string/culture_detail_focus"
                    android:textAppearance="@style/TextAppearance.LS.Title" />
                <TextView
                    android:id="@+id/detailFocus"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap_sm"
                    android:textAppearance="@style/TextAppearance.LS.Body" />
                <TextView
                    android:id="@+id/detailTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textLocale="zh-CN"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.littlestar.app.core.ui.LearningButton
        android:id="@+id/btnListen"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ls_margin"
        android:layout_marginEnd="@dimen/ls_margin"
        android:layout_marginBottom="@dimen/ls_gap"
        android:enabled="false"
        android:contentDescription="@string/culture_detail_listen"
        android:minHeight="@dimen/ls_btn_icon"
        android:text="@string/culture_detail_listen"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart" />
</LinearLayout>
