<?xml version="1.0" encoding="utf-8"?>
<!-- §7.12 设置验证：PIN + 确认；adjustResize 保证键盘不遮按钮 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:text="@string/pg_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />
        </LinearLayout>

        <!-- 锁块 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_stamp"
                android:layout_height="@dimen/ls_stamp"
                app:ls_fill="@color/ls_primary_container"
                app:ls_pressable="false">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ls_primary" />
            </com.littlestar.app.core.ui.BlockLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/pg_title"
                    android:textAppearance="@style/TextAppearance.LS.Display" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pg_sub"
                    android:textAppearance="@style/TextAppearance.LS.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- PIN 提示、输入和确认放在同一个表单。 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LS.Card.Story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ls_card_pad">
                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Title" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/pinField"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:hint="@string/pg_answer_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/answerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:maxLength="4" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:minHeight="@dimen/ls_btn_icon"
                    android:text="@string/pg_confirm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/pg_hint1"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:text="@string/pg_hint2"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
