<?xml version="1.0" encoding="utf-8"?>
<!-- A1 帮助页：提醒说明 + 测试通知 + 关于；菜单在 HelpActivity 里 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ls_paper"
        app:titleTextAppearance="@style/TextAppearance.LS.Title"
        app:titleTextColor="@color/ls_ink" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/ls_content_max_width"
            android:orientation="vertical"
            android:padding="@dimen/ls_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_intro"
                android:textAppearance="@style/TextAppearance.LS.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_section"
                android:text="@string/help_reminders_title"
                android:textAppearance="@style/TextAppearance.LS.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_gap_sm"
                android:text="@string/help_reminders_body"
                android:textAppearance="@style/TextAppearance.LS.Body" />

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnTestNotification"
                style="@style/Widget.LS.Block.Primary.Blue"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_secondary"
                android:layout_marginTop="@dimen/ls_section">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/help_test_notification"
                    android:textAppearance="@style/TextAppearance.LS.Button"
                    android:textColor="@color/ls_on_blue" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_gap_sm"
                android:text="@string/help_permission_hint"
                android:textAppearance="@style/TextAppearance.LS.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_section"
                android:text="@string/help_offline_title"
                android:textAppearance="@style/TextAppearance.LS.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_gap_sm"
                android:text="@string/help_offline_body"
                android:textAppearance="@style/TextAppearance.LS.Body" />

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnAbout"
                style="@style/Widget.LS.Block.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_secondary"
                android:layout_marginTop="@dimen/ls_section">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ls_gap"
                    android:paddingEnd="@dimen/ls_gap">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/help_about"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/ls_icon"
                        android:layout_height="@dimen/ls_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/ls_ink" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
