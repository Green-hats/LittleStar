<?xml version="1.0" encoding="utf-8"?>
<!-- §7.15 学习计划：步进器 + 提醒时间行 + 7 星期块 + 本周目标卡 + 保存/取消 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/planRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:text="@string/pp_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/pp_title"
            android:textAppearance="@style/TextAppearance.LS.Headline" />

        <com.littlestar.app.core.ui.StepperView
            android:id="@+id/goalStepper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            app:maxValue="10"
            app:minValue="1"
            app:value="3" />

        <!-- 提醒时间行 -->
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/timeRow"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ls_gap"
                android:paddingEnd="@dimen/ls_gap">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:text="@string/pp_reminder"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />

                <com.littlestar.app.core.ui.BlockLayout
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ls_module_glyph"
                    app:ls_fill="@color/ls_yellow"
                    app:ls_pressable="false">

                    <TextView
                        android:id="@+id/timeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="@dimen/ls_gap"
                        android:paddingEnd="@dimen/ls_gap"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textColor="@color/ls_on_yellow"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <!-- 星期块（44×48，间距 0） -->
        <LinearLayout
            android:id="@+id/weekdayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:gravity="center_horizontal"
            android:orientation="horizontal" />

        <!-- 通知关闭提示行（被拒后显示） -->
        <TextView
            android:id="@+id/notifOffHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/pp_notif_off"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textColor="@color/ls_red"
            android:visibility="gone" />

        <!-- 本周目标卡 -->
        <com.littlestar.app.core.ui.BlockLayout
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_section"
            app:ls_pressable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/ls_gap">

                <TextView
                    android:id="@+id/weeklyGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weeklyGoalSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Caption" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/btnSave"
            style="@style/Widget.LS.Block.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_btn_secondary"
            android:layout_marginTop="@dimen/ls_section">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/pt_save"
                android:textAppearance="@style/TextAppearance.LS.Button" />
        </com.littlestar.app.core.ui.BlockLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ls_gap"
            android:padding="@dimen/ls_gap_sm"
            android:text="@string/pt_cancel"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
