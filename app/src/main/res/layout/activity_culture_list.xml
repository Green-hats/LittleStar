<?xml version="1.0" encoding="utf-8"?>
<!-- §7.8 文化列表：类别头 + 80dp 行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cultureListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back"
                app:icon="@drawable/ic_back" />

            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_gap" android:orientation="vertical">
                <TextView android:id="@+id/categoryName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.Title" />
                <TextView android:id="@+id/categoryCount" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.Caption" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/itemList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ls_gap"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </LinearLayout>
</LinearLayout>
