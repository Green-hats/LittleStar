<?xml version="1.0" encoding="utf-8"?>
<!-- 文化行（列表 / 收藏共用）：56dp 封面 + 标题 + 类型·时长 + 播放钮（列表）或红心（收藏） -->
<com.littlestar.app.core.ui.BlockLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowBlock"
    style="@style/Widget.LS.Block.Secondary"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ls_row_culture"
    android:layout_marginBottom="@dimen/ls_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ls_gap"
        android:paddingEnd="@dimen/ls_gap">

        <FrameLayout
            android:layout_width="@dimen/ls_cover"
            android:layout_height="@dimen/ls_cover">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ill_placeholder" />

            <com.littlestar.app.core.ui.HanziTextView
                android:id="@+id/rowGlyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.LS.HanziTile"
                android:textColor="@color/ls_on_yellow"
                android:textSize="24sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ls_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LS.Body"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rowSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LS.Caption" />
        </LinearLayout>

        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/btnPlay"
            style="@style/Widget.LS.Block.Icon"
            android:layout_width="@dimen/ls_module_glyph"
            android:layout_height="@dimen/ls_module_glyph"
            app:ls_fill="@color/ls_blue">

            <ImageView
                android:layout_width="@dimen/ls_icon"
                android:layout_height="@dimen/ls_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play"
                app:tint="@color/ls_on_blue" />
        </com.littlestar.app.core.ui.BlockLayout>

        <ImageView
            android:id="@+id/btnHeart"
            android:layout_width="@dimen/ls_module_glyph"
            android:layout_height="@dimen/ls_module_glyph"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_desc_fav"
            android:padding="@dimen/ls_gap_sm"
            android:src="@drawable/ic_heart"
            android:visibility="gone" />
    </LinearLayout>
</com.littlestar.app.core.ui.BlockLayout>
