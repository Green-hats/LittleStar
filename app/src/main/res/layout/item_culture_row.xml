<?xml version="1.0" encoding="utf-8"?>
<com.littlestar.app.core.ui.BlockLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rowBlock" style="@style/Widget.LS.Block.Tile"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ls_gap">
    <LinearLayout android:id="@+id/rowContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/ls_gap" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/rowCover" android:layout_width="@dimen/ls_culture_thumbnail"
                android:layout_height="@dimen/ls_culture_thumbnail" android:layout_marginEnd="@dimen/ls_gap"
                android:background="@drawable/bg_home_icon" android:backgroundTint="@color/ls_surface_container"
                android:importantForAccessibility="no" android:scaleType="fitCenter"
                app:shapeAppearance="?attr/shapeAppearanceCornerMedium" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/rowTitleEn" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Title" />
                <TextView android:id="@+id/rowTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Body" />
                <TextView android:id="@+id/rowSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap_sm" android:textAppearance="@style/TextAppearance.LS.Caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ls_gap_sm" android:layout_weight="1"
                android:text="@string/culture_list_details"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="@color/ls_primary" />
            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnPlay"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/ls_play_shortcut"
                android:minHeight="@dimen/ls_btn_icon"
                android:text="@string/culture_list_play"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.littlestar.app.core.ui.BlockLayout>
