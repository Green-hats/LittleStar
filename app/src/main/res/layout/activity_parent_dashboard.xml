<?xml version="1.0" encoding="utf-8"?>
<!-- §7.13 学习概览：3 统计块 + 本周柱状图 + 三行入口；右上 Settings -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:text="@string/pd_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/ls_gap_sm"
                android:text="@string/pd_settings"
                android:textAppearance="@style/TextAppearance.LS.Caption"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:text="@string/pd_greeting"
            android:textAppearance="@style/TextAppearance.LS.Headline" />

        <TextView
            android:id="@+id/todayDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:textAppearance="@style/TextAppearance.LS.Caption" />

        <!-- 三张统计块 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                style="@style/Widget.LS.Block.Parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:ls_pressable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/ls_gap">

                    <TextView
                        android:id="@+id/statMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_unit_min"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_today_minutes"
                        android:textAppearance="@style/TextAppearance.LS.Caption"
                        android:textColor="@color/ls_ink" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                style="@style/Widget.LS.Block.Parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                app:ls_pressable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/ls_gap">

                    <TextView
                        android:id="@+id/statLearned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_unit_ge"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_today_learned"
                        android:textAppearance="@style/TextAppearance.LS.Caption"
                        android:textColor="@color/ls_ink" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                style="@style/Widget.LS.Block.Parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                app:ls_pressable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/ls_gap">

                    <TextView
                        android:id="@+id/statQuiz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_quiz_percent"
                        android:textAppearance="@style/TextAppearance.LS.Caption"
                        android:textColor="@color/ls_ink" />
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>

        <!-- 本周柱状图 -->
        <com.littlestar.app.core.ui.BlockLayout
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            app:ls_pressable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ls_card_pad">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pd_week"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weekTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <com.littlestar.app.core.ui.BarChartView
                    android:id="@+id/weekChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ls_chart_height"
                    android:layout_marginTop="@dimen/ls_gap" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <!-- 三行入口 -->
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/rowTime"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ls_gap"
                android:paddingEnd="@dimen/ls_gap">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_row_time"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rowTimeSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/rowPlan"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ls_gap"
                android:paddingEnd="@dimen/ls_gap">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_row_plan"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rowPlanSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/rowRecords"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ls_gap"
                android:paddingEnd="@dimen/ls_gap">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_history" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_row_records"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pd_row_records_sub"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
