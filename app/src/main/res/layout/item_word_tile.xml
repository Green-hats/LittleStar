<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wordTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sprout_space"
    style="@style/Widget.Sprout.Card"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <ImageView
                android:id="@+id/wordDone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp">
            <com.littlestar.app.core.ui.HanziTextView
                android:id="@+id/wordGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="44sp"
                android:textColor="@color/sprout_on_lilac"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/wordIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <com.littlestar.app.core.ui.HanziTextView
            android:id="@+id/wordHanzi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textColor="@color/sprout_on_lilac"
            android:gravity="center" />

        <TextView
            android:id="@+id/wordPinyin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Caption"
            android:gravity="center" />

        <TextView
            android:id="@+id/wordEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Section"
            android:gravity="center" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
