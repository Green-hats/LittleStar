<?xml version="1.0" encoding="utf-8"?>
<!-- §7.7 文化分类：MVP 3 类（2 + 古诗宽卡），统一青绿字形块；轻量聆听提示 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cultureRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:text="@string/cul_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/cul_title"
            android:textAppearance="@style/TextAppearance.LS.Headline" />

        <!-- 2 类方块 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/catSongs"
                style="@style/Widget.LS.Block.Tile"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_theme_tile_height"
                android:layout_weight="1">

                <com.littlestar.app.core.ui.BlockLayout
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="@dimen/ls_module_glyph"
                    android:layout_height="@dimen/ls_module_glyph"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_marginTop="@dimen/ls_gap"
                    app:ls_fill="@color/ls_green">

                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/glyphSongs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/ls_on_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_marginBottom="@dimen/ls_gap"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nameSongs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Title" />

                    <TextView
                        android:id="@+id/nameSongsEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.English.Small" />

                    <TextView
                        android:id="@+id/countSongs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/ls_gap"
                    android:layout_marginBottom="@dimen/ls_gap"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/catStories"
                style="@style/Widget.LS.Block.Tile"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_theme_tile_height"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1">

                <com.littlestar.app.core.ui.BlockLayout
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="@dimen/ls_module_glyph"
                    android:layout_height="@dimen/ls_module_glyph"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_marginTop="@dimen/ls_gap"
                    app:ls_fill="@color/ls_green">

                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/glyphStories"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/ls_on_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_marginBottom="@dimen/ls_gap"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nameStories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Title" />

                    <TextView
                        android:id="@+id/nameStoriesEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.English.Small" />

                    <TextView
                        android:id="@+id/countStories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/ls_gap"
                    android:layout_marginBottom="@dimen/ls_gap"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>

        <!-- 古诗宽卡 -->
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/catPoems"
            style="@style/Widget.LS.Block.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_row_culture"
            android:layout_marginTop="@dimen/ls_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ls_gap">

                <com.littlestar.app.core.ui.BlockLayout
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="@dimen/ls_module_glyph"
                    android:layout_height="@dimen/ls_module_glyph"
                    app:ls_fill="@color/ls_green">

                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/glyphPoems"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/ls_on_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/namePoems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Title" />

                    <TextView
                        android:id="@+id/namePoemsEn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.English.Small" />

                    <TextView
                        android:id="@+id/countPoems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <!-- 轻量提示跟随内容，不固定在屏幕底部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_panda" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap_sm"
                android:text="@string/cul_slogan"
                android:textAppearance="@style/TextAppearance.LS.Caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
