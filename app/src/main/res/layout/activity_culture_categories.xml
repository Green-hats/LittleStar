<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cultureCategoriesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/sprout_cloud">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sprout_gutter"
        android:paddingEnd="@dimen/sprout_gutter"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Sprout.Back"
                android:text="@string/sprout_back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sprout.Title"
                android:text="@string/sprout_culture"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Caption"
            android:text="@string/sprout_culture_welcome" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/catSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:minHeight="102dp">
                <ImageView
                    android:id="@+id/iconSongs"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_music"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/nameSongsEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Section" />

                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/nameSongs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/countSongs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/catStories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:minHeight="102dp">
                <ImageView
                    android:id="@+id/iconStories"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_book"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/nameStoriesEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Section" />

                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/nameStories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/countStories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/catPoems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:minHeight="102dp">
                <ImageView
                    android:id="@+id/iconPoems"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_scroll"
                    app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/namePoemsEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Section" />

                    <com.littlestar.app.core.ui.HanziTextView
                        android:id="@+id/namePoems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/countPoems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
