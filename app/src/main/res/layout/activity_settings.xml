<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/sprout_cloud">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sprout_gutter"
        android:paddingEnd="@dimen/sprout_gutter"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Sprout.Back"
                android:text="@string/sprout_back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sprout.Title"
                android:text="@string/settings_title"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:accessibilityHeading="true" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/settingsToolbar"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:text="@string/settings_goal"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Caption"
                    android:text="@string/settings_goal_hint"
                    android:layout_marginTop="4dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <com.littlestar.app.core.ui.StepperView
                    android:id="@+id/goalStepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Card"
            app:cardBackgroundColor="@color/sprout_dew">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Section"
                    android:text="@string/sprout_reminders"
                    android:accessibilityHeading="true" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/timeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Card"
                    app:cardBackgroundColor="@color/sprout_lilac"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingHorizontal="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Sprout.Caption"
                            android:text="@string/settings_reminder"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/timeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Sprout.Section" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Caption"
                    android:text="@string/settings_reminders_hint"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/weekdayRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Button"
            android:text="@string/settings_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Secondary"
            android:text="@string/settings_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
