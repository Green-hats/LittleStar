<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">
                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.LS.Title"
                android:id="@+id/settingsTitle" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/settings_goal"
            android:textAppearance="@style/TextAppearance.LS.Title" />
        <com.littlestar.app.core.ui.StepperView
            android:id="@+id/goalStepper"
            android:contentDescription="@string/settings_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            app:maxValue="10"
            app:minValue="1"
            app:value="3" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/settings_goal_hint"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/settings_reminders"
            android:textAppearance="@style/TextAppearance.LS.Title" />
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/timeRow"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_gap_sm">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ls_gap"
                android:paddingEnd="@dimen/ls_gap">
                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:text="@string/settings_reminder"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
                <com.littlestar.app.core.ui.BlockLayout
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ls_module_glyph"
                    app:ls_fill="@color/ls_yellow"
                    app:ls_pressable="false">
                    <TextView
                        android:id="@+id/timeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="@dimen/ls_gap"
                        android:paddingEnd="@dimen/ls_gap"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textColor="@color/ls_on_yellow"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
        <LinearLayout
            android:id="@+id/weekdayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:gravity="center_horizontal"
            android:orientation="horizontal" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/settings_reminders_hint"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/btnSave"
            style="@style/Widget.LS.Block.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_btn_secondary"
            android:layout_marginTop="@dimen/ls_section">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/settings_save"
                android:textAppearance="@style/TextAppearance.LS.Button" />
        </com.littlestar.app.core.ui.BlockLayout>
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ls_gap"
            android:padding="@dimen/ls_gap_sm"
            android:text="@string/settings_cancel"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
