<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Navigation"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">
                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/settingsToolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp">
                <TextView
                    android:id="@+id/settingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textAppearance="@style/TextAppearance.LS.Title" />
            </com.google.android.material.appbar.MaterialToolbar>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/settings_goal"
            android:textAppearance="@style/TextAppearance.LS.Title" />
        <com.littlestar.app.core.ui.StepperView
            android:id="@+id/goalStepper"
            android:contentDescription="@string/settings_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            app:maxValue="10"
            app:minValue="1"
            app:value="3" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/settings_goal_hint"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/settings_reminders"
            android:textAppearance="@style/TextAppearance.LS.Title" />
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/timeRow"
            style="@style/Widget.LS.Block.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_gap_sm">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ls_row_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ls_gap"
                android:paddingEnd="@dimen/ls_gap">
                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:text="@string/settings_reminder"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
                <com.littlestar.app.core.ui.BlockLayout
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ls_fill="@color/ls_primary_container"
                    app:ls_pressable="false">
                    <TextView
                        android:id="@+id/timeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/ls_gap"
                        android:paddingVertical="@dimen/ls_gap_sm"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textColor="@color/ls_primary"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
        <LinearLayout
            android:id="@+id/weekdayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:gravity="center_horizontal"
            android:orientation="horizontal" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/settings_reminders_hint"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:minHeight="@dimen/ls_btn_primary"
            android:text="@string/settings_save" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/settings_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
