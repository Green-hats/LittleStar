<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/ls_margin">

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 黄色舞台 + 睡熊猫 -->
    <com.littlestar.app.core.ui.BlockLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:ls_cornerRadius="@dimen/ls_radius_hero"
        app:ls_fill="@color/ls_yellow"
        app:ls_pressable="false"
        app:ls_shadowOffset="@dimen/ls_shadow_hero"
        app:ls_strokeWidth="@dimen/ls_stroke_hero">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_panda_sleep" />
    </com.littlestar.app.core.ui.BlockLayout>

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.LS.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ls_section_lg"
        android:text="@string/timeup_rest_title" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/TextAppearance.LS.English"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ls_gap_sm" />

    <com.littlestar.app.core.ui.BlockLayout
        android:id="@+id/countdown"
        style="@style/Widget.LS.Block.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/ls_section"
        android:minWidth="200dp"
        app:ls_pressable="false">

        <TextView
            android:id="@+id/countdownText"
            style="@style/TextAppearance.LS.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/timeup_rest_done" />
    </com.littlestar.app.core.ui.BlockLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.littlestar.app.core.ui.BlockLayout
        android:id="@+id/btnOk"
        style="@style/Widget.LS.Block.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ls_btn_primary"
        android:clickable="true"
        android:focusable="true">

        <TextView
            style="@style/TextAppearance.LS.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/timeup_ok" />
    </com.littlestar.app.core.ui.BlockLayout>

    <TextView
        android:id="@+id/parentEntry"
        style="@style/TextAppearance.LS.Caption"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ls_btn_icon"
        android:layout_marginTop="@dimen/ls_gap"
        android:gravity="center"
        android:minWidth="200dp"
        android:text="@string/timeup_parent_entry" />
</LinearLayout>
