<?xml version="1.0" encoding="utf-8"?>
<!-- §7.14 使用时长：4 选项（选中黄底+勾）+ 休息提醒开关 + 加时行（达上限才显示）+ 保存/取消 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnBack"
                style="@style/Widget.LS.Block.Icon"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_back" />
            </com.littlestar.app.core.ui.BlockLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:text="@string/pt_top"
                android:textAppearance="@style/TextAppearance.LS.Title" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/pt_title"
            android:textAppearance="@style/TextAppearance.LS.Headline" />

        <!-- 15 / 30 / 45 / 60（debug 多一个 1 分钟验收选项） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/opt1"
                style="@style/Widget.LS.Block.Option"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginEnd="@dimen/ls_gap_sm"
                android:layout_weight="1"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/opt15"
                style="@style/Widget.LS.Block.Option"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/opt30"
                style="@style/Widget.LS.Block.Option"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginStart="@dimen/ls_gap_sm"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/opt45"
                style="@style/Widget.LS.Block.Option"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginStart="@dimen/ls_gap_sm"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/opt60"
                style="@style/Widget.LS.Block.Option"
                android:layout_width="0dp"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginStart="@dimen/ls_gap_sm"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.LS.Body"
                    android:textStyle="bold" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>

        <!-- 休息提醒开关（家长区可用 Material 组件） -->
        <com.littlestar.app.core.ui.BlockLayout
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_section"
            app:ls_pressable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ls_gap">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pt_rest"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pt_rest_sub"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/restSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <!-- 今天已达上限才显示：再给 10 分钟 -->
        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/extraRow"
            style="@style/Widget.LS.Block.Parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_row_parent"
            android:layout_marginTop="@dimen/ls_gap"
            android:visibility="gone"
            app:ls_pressable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ls_gap">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pt_extra"
                    android:textAppearance="@style/TextAppearance.LS.Caption"
                    android:textColor="@color/ls_ink" />

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/btnExtra"
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ls_btn_icon"
                    app:ls_fill="@color/ls_yellow">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="@dimen/ls_gap"
                        android:paddingEnd="@dimen/ls_gap"
                        android:text="@string/pt_extra_btn"
                        android:textAppearance="@style/TextAppearance.LS.Caption"
                        android:textColor="@color/ls_on_yellow"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.littlestar.app.core.ui.BlockLayout
            android:id="@+id/btnSave"
            style="@style/Widget.LS.Block.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_btn_secondary"
            android:layout_marginTop="@dimen/ls_section">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/pt_save"
                android:textAppearance="@style/TextAppearance.LS.Button" />
        </com.littlestar.app.core.ui.BlockLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ls_gap"
            android:padding="@dimen/ls_gap_sm"
            android:text="@string/pt_cancel"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
