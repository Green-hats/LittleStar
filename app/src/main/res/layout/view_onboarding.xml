<?xml version="1.0" encoding="utf-8"?>
<!-- §7.20 首次引导：HomeActivity 的 firstLaunch 态。step1 年龄+目标 → step2 提醒。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/obRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ls_margin">
    <!-- ===== 第一步：年龄与目标 ===== -->
    <LinearLayout
        android:id="@+id/obStep1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/ob_step_1"
            android:textAppearance="@style/TextAppearance.LS.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ls_gap"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/ob_title_setup"
                android:textAppearance="@style/TextAppearance.LS.Display" />

            <ImageView
                android:layout_width="@dimen/ls_onboarding_illustration"
                android:layout_height="@dimen/ls_onboarding_illustration"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/panda_reading" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/ob_subtitle_setup"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_card_pad"
            android:text="@string/ob_age_label"
            android:textAppearance="@style/TextAppearance.LS.Body"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            app:chipSpacing="@dimen/ls_gap_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/obAge3"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/obAge4"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/obAge5"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/obAge6"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/ob_goal_label"
            android:textAppearance="@style/TextAppearance.LS.Body"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            app:chipSpacing="@dimen/ls_gap_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/obGoal1"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/obGoal3"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.chip.Chip
                android:id="@+id/obGoal5"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 建议卡 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LS.Card.Story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_btn_secondary"
            android:layout_marginTop="@dimen/ls_section"
            app:cardBackgroundColor="?attr/colorPrimaryContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ls_gap">

                <ImageView
                    android:layout_width="@dimen/ls_icon"
                    android:layout_height="@dimen/ls_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/ls_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/obSuggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ob_suggestion_sub"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/obNext"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/ob_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/obSkip1"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/ob_skip" />
    </LinearLayout>

    <!-- ===== 第二步：提醒 ===== -->
    <LinearLayout
        android:id="@+id/obStep2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/ob_step_2"
            android:textAppearance="@style/TextAppearance.LS.Caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section_lg"
            android:accessibilityHeading="true"
            android:text="@string/ob_title_notify"
            android:textAppearance="@style/TextAppearance.LS.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/ob_subtitle_notify"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <!-- 提醒卡 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LS.Card.Story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ls_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.littlestar.app.core.ui.BlockLayout
                        style="@style/Widget.LS.Block.Icon"
                        android:layout_width="@dimen/ls_btn_icon"
                        android:layout_height="@dimen/ls_btn_icon"
                        app:ls_fill="@color/ls_yellow"
                        app:ls_pressable="false">

                        <ImageView
                            android:layout_width="@dimen/ls_icon"
                            android:layout_height="@dimen/ls_icon"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/ls_on_yellow" />
                    </com.littlestar.app.core.ui.BlockLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ls_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_notify_time"
                            android:textAppearance="@style/TextAppearance.LS.Headline" />

                        <TextView
                            android:id="@+id/obNotifyDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:background="@drawable/bg_notify_preview"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ls_gap">

                    <ImageView
                        android:layout_width="@dimen/ls_icon"
                        android:layout_height="@dimen/ls_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ls_gap_sm"
                        android:text="@string/ob_notify_preview"
                        android:textAppearance="@style/TextAppearance.LS.Body" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:text="@string/ob_notify_note"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/obAllow"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/ob_allow" />

        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/obLater"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/ob_later" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:text="@string/ob_notify_footer"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
    </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
