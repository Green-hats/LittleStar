<?xml version="1.0" encoding="utf-8"?>
<!-- 测验选项块：汉字 34sp + 拼音 12sp + 角标（答对勾 / 答错 ×） -->
<com.littlestar.app.core.ui.BlockLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optionBlock"
    style="@style/Widget.LS.Block.Option"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.littlestar.app.core.ui.HanziTextView
            android:id="@+id/optionHanzi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LS.HanziOption" />

        <TextView
            android:id="@+id/optionPinyin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LS.Caption" />
    </LinearLayout>

    <ImageView
        android:id="@+id/optionBadge"
        android:layout_width="@dimen/ls_badge"
        android:layout_height="@dimen/ls_badge"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/ls_gap_sm"
        android:layout_marginEnd="@dimen/ls_gap_sm"
        android:importantForAccessibility="no"
        android:padding="@dimen/ls_badge_pad"
        android:visibility="gone" />
</com.littlestar.app.core.ui.BlockLayout>
