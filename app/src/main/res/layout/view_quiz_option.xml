<?xml version="1.0" encoding="utf-8"?>
<com.littlestar.app.feature.quiz.AnswerCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optionBlock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Sprout.Card"
    app:cardBackgroundColor="@color/ls_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:strokeColor="@color/sprout_outline"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:minHeight="60dp">
        <com.littlestar.app.core.ui.HanziTextView
            android:id="@+id/optionHanzi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textColor="@color/sprout_on_lilac"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/optionBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>
</com.littlestar.app.feature.quiz.AnswerCardView>
