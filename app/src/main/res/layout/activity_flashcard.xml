<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flashcardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sprout_cloud">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/flashcardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/sprout_cloud">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/sprout_gutter"
            android:paddingEnd="@dimen/sprout_gutter"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Sprout.Back"
                    android:text="@string/sprout_back"
                    app:icon="@drawable/ic_back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Sprout.Title"
                    android:text="@string/sprout_meet"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:accessibilityHeading="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/cardCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sprout.Caption"
                android:text="@string/sprout_today_loading" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:indicatorColor="@color/sprout_fern"
                app:trackColor="@color/sprout_dew"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp"
                android:layout_marginTop="12dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <include
                android:id="@+id/pageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/page_flashcard"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/audioMissing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Sprout.Card"
                app:cardBackgroundColor="@color/sprout_peach"
                android:visibility="gone"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sprout.Section"
                        android:text="@string/pr_audio_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAudioRetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Sprout.Secondary"
                        android:text="@string/sprout_listen"
                        app:icon="@drawable/ic_speaker" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAudioContinue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Sprout.Back"
                        android:text="@string/sprout_dismiss" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Sprout.Secondary"
                android:text="@string/sprout_mark"
                app:icon="@drawable/ic_check"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/flashcardActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sprout_gutter"
        android:paddingEnd="@dimen/sprout_gutter"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Secondary"
            android:text="@string/sprout_listen"
            app:icon="@drawable/ic_speaker" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Button"
            android:text="@string/sprout_next"
            app:icon="@drawable/ic_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rotationGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_rotate_portrait"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/rotationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sprout.Section"
            android:text="@string/sprout_rotate"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rotationBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Sprout.Back"
            android:text="@string/sprout_back"
            app:icon="@drawable/ic_back" />
    </LinearLayout>
</LinearLayout>
