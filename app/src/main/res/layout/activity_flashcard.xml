<?xml version="1.0" encoding="utf-8"?>
<!-- §7.4 识字卡：顶栏（返回 + 主题名 + k/N）+ 进度段 + ViewPager2 主角卡 + 印章 + NEXT。
     音频缺失时盖 38% 墨色遮罩 + 页面内对话框（孩子区不用系统对话框）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper">

    <LinearLayout
        android:id="@+id/flashcardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/ls_content_max_width"
            android:orientation="vertical"
            android:padding="@dimen/ls_margin">

            <!-- 顶栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/btnBack"
                    style="@style/Widget.LS.Block.Icon"
                    android:layout_width="@dimen/ls_btn_icon"
                    android:layout_height="@dimen/ls_btn_icon"
                    android:contentDescription="@string/nav_back">

                    <ImageView
                        android:layout_width="@dimen/ls_icon"
                        android:layout_height="@dimen/ls_icon"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_back" />
                </com.littlestar.app.core.ui.BlockLayout>

                <TextView
                    android:id="@+id/cardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1"
                    android:text="@string/fc_session_title"
                    android:textAppearance="@style/TextAppearance.LS.Title" />

                <TextView
                    android:id="@+id/cardCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LS.Title"
                    android:textColor="@color/ls_muted" />
            </LinearLayout>

            <com.littlestar.app.core.ui.SegmentProgressView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_seg_height"
                android:layout_marginTop="@dimen/ls_gap" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/ls_gap"
                android:layout_weight="1" />

            <!-- 底部：印章 + NEXT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_gap"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.littlestar.app.core.ui.StampView
                        android:id="@+id/stamp"
                        android:layout_width="@dimen/ls_stamp"
                        android:layout_height="@dimen/ls_stamp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ls_gap_sm"
                        android:text="@string/fc_stamp_label"
                        android:textAppearance="@style/TextAppearance.LS.Caption" />
                </LinearLayout>

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/btnNext"
                    style="@style/Widget.LS.Block.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ls_btn_primary"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnNextText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_next"
                            android:textAppearance="@style/TextAppearance.LS.Button" />

                        <ImageView
                            android:layout_width="@dimen/ls_icon"
                            android:layout_height="@dimen/ls_icon"
                            android:layout_marginStart="@dimen/ls_gap_sm"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            app:tint="@color/ls_on_red" />
                    </LinearLayout>
                </com.littlestar.app.core.ui.BlockLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 音频缺失遮罩 + 页面内对话框（§7.26） -->
    <FrameLayout
        android:id="@+id/audioMissing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ls_ink_scrim" />

        <com.littlestar.app.core.ui.BlockLayout
            style="@style/Widget.LS.Block.Secondary"
            android:layout_width="@dimen/ls_ob_dialog_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:ls_pressable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/ls_card_pad">

                <ImageView
                    android:layout_width="@dimen/ls_btn_icon"
                    android:layout_height="@dimen/ls_btn_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/ls_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:text="@string/fc_audio_missing_title"
                    android:textAppearance="@style/TextAppearance.LS.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap_sm"
                    android:text="@string/fc_audio_missing_msg"
                    android:textAppearance="@style/TextAppearance.LS.Caption"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ls_gap"
                    android:orientation="horizontal">

                    <com.littlestar.app.core.ui.BlockLayout
                        android:id="@+id/btnAudioContinue"
                        style="@style/Widget.LS.Block.Option"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ls_btn_icon"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/fc_audio_continue"
                            android:textAppearance="@style/TextAppearance.LS.Body" />
                    </com.littlestar.app.core.ui.BlockLayout>

                    <com.littlestar.app.core.ui.BlockLayout
                        android:id="@+id/btnAudioRetry"
                        style="@style/Widget.LS.Block.Option"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ls_btn_icon"
                        android:layout_marginStart="@dimen/ls_gap"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/fc_audio_retry"
                            android:textAppearance="@style/TextAppearance.LS.Body" />
                    </com.littlestar.app.core.ui.BlockLayout>
                </LinearLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
    </FrameLayout>
</FrameLayout>
