<?xml version='1.0' encoding='utf-8'?>
<!-- §7.4 识字卡：ConstraintLayout 响应式布局，顶栏（返回 + 主题名 + k/N）+ 进度段 + ViewPager2 主角卡 + 印章 + NEXT。
     音频缺失时盖 38% 墨色遮罩 + 页面内对话框（孩子区不用系统对话框）。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_paper">

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/flashcardRoot" android:layout_width="0dp" android:layout_height="0dp" android:padding="@dimen/ls_margin" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_max="@dimen/ls_content_max_width">

        <!-- 顶栏 -->
        <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnBack" style="@style/Widget.LS.Block.Icon" android:layout_width="@dimen/ls_btn_icon" android:layout_height="@dimen/ls_btn_icon" android:contentDescription="@string/nav_back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

            <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_back"/>
        </com.littlestar.app.core.ui.BlockLayout>

        <TextView android:id="@+id/cardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ls_gap" android:layout_marginEnd="@dimen/ls_gap" android:text="@string/fc_session_title" android:textAppearance="@style/TextAppearance.LS.Title" app:layout_constraintBottom_toBottomOf="@id/btnBack" app:layout_constraintEnd_toStartOf="@id/cardCounter" app:layout_constraintStart_toEndOf="@id/btnBack" app:layout_constraintTop_toTopOf="@id/btnBack" android:maxLines="1" android:ellipsize="end"/>

        <TextView android:id="@+id/cardCounter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.LS.Title" android:textColor="@color/ls_muted" app:layout_constraintBottom_toBottomOf="@id/btnBack" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/btnBack"/>

        <com.littlestar.app.core.ui.SegmentProgressView android:id="@+id/cardProgress" android:layout_width="0dp" android:layout_height="@dimen/ls_seg_height" android:layout_marginTop="@dimen/ls_gap" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnBack"/>

        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="@dimen/ls_gap" android:layout_marginBottom="@dimen/ls_gap" app:layout_constraintBottom_toTopOf="@id/flashcardFooter" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/cardProgress"/>

        <!-- 底部：印章 + NEXT -->
        <LinearLayout android:id="@+id/flashcardFooter" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.littlestar.app.core.ui.StampView android:id="@+id/stamp" android:layout_width="@dimen/ls_stamp" android:layout_height="@dimen/ls_stamp" app:layout_constraintBottom_toTopOf="@id/stampLabel" app:layout_constraintEnd_toEndOf="@id/stampLabel" app:layout_constraintStart_toStartOf="@id/stampLabel" app:layout_constraintTop_toTopOf="parent"/>

            <TextView android:id="@+id/stampLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap_sm" android:text="@string/pr_stamp_optional" android:textAppearance="@style/TextAppearance.LS.Caption" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/stamp" app:layout_constraintBottom_toBottomOf="parent"/>

            <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnNext" style="@style/Widget.LS.Block.Primary" android:layout_width="0dp" android:layout_height="@dimen/ls_btn_primary" android:layout_marginStart="@dimen/ls_gap" app:layout_constraintBottom_toBottomOf="@id/stampLabel" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/stampLabel">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal">

                    <TextView android:id="@+id/btnNextText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fc_next" android:textAppearance="@style/TextAppearance.LS.Button"/>

                    <ImageView android:layout_width="@dimen/ls_icon" android:layout_height="@dimen/ls_icon" android:layout_marginStart="@dimen/ls_gap_sm" android:importantForAccessibility="no" android:src="@drawable/ic_chevron" app:tint="@color/ls_on_red"/>
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>
        </androidx.constraintlayout.widget.ConstraintLayout><TextView android:id="@+id/stampExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/pr_stamp_explanation" android:textAppearance="@style/TextAppearance.LS.Caption" android:textSize="12sp" android:accessibilityLiveRegion="polite"/></LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 音频缺失遮罩 + 页面内对话框（§7.26） -->
    <FrameLayout android:id="@+id/audioMissing" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:clickable="true" android:focusable="true">

        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ls_ink_scrim"/>

        <com.littlestar.app.core.ui.BlockLayout style="@style/Widget.LS.Block.Secondary" android:layout_width="@dimen/ls_ob_dialog_width" android:layout_height="wrap_content" android:layout_gravity="center" app:ls_pressable="false">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/ls_card_pad">

                <ImageView android:layout_width="@dimen/ls_btn_icon" android:layout_height="@dimen/ls_btn_icon" android:importantForAccessibility="no" android:src="@drawable/ic_speaker" app:tint="@color/ls_muted"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" android:text="@string/pr_audio_title" android:textAppearance="@style/TextAppearance.LS.Title"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap_sm" android:text="@string/pr_audio_message" android:textAppearance="@style/TextAppearance.LS.Caption" android:textSize="14sp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ls_gap" android:orientation="horizontal">

                    <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnAudioContinue" style="@style/Widget.LS.Block.Option" android:layout_width="0dp" android:layout_height="@dimen/ls_btn_icon" android:layout_weight="1">

                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/fc_audio_continue" android:textAppearance="@style/TextAppearance.LS.Body" android:id="@+id/audioContinueLabel"/>
                    </com.littlestar.app.core.ui.BlockLayout>

                    <com.littlestar.app.core.ui.BlockLayout android:id="@+id/btnAudioRetry" style="@style/Widget.LS.Block.Option" android:layout_width="0dp" android:layout_height="@dimen/ls_btn_icon" android:layout_marginStart="@dimen/ls_gap" android:layout_weight="1">

                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/pr_audio_retry" android:textAppearance="@style/TextAppearance.LS.Body"/>
                    </com.littlestar.app.core.ui.BlockLayout>
                </LinearLayout>
            </LinearLayout>
        </com.littlestar.app.core.ui.BlockLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
