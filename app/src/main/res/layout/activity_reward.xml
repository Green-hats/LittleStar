<?xml version="1.0" encoding="utf-8"?>
<!-- §7.6 完成：黄色舞台 + 熊猫 + 本轮字块 + 完成 / 再来一次 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rewardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <!-- 黄色舞台（confetti 只在舞台内） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stage"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ls_reward_stage"
            android:layout_marginTop="@dimen/ls_section"
            app:cardBackgroundColor="@color/ls_yellow">

            <ImageView
                android:layout_width="@dimen/ls_reward_panda"
                android:layout_height="@dimen/ls_reward_panda"
                android:layout_gravity="center"
                android:contentDescription="@string/home_panda_desc"
                android:src="@drawable/ic_panda" />

            <FrameLayout
                android:id="@+id/confettiLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:text="@string/reward_title"
            android:textAppearance="@style/TextAppearance.LS.Display" />

        <TextView
            android:id="@+id/rewardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap_sm"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <!-- 本轮学会的字块 -->
        <LinearLayout
            android:id="@+id/wordsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:orientation="horizontal" />

        <!-- 次入口：本轮答题回顾（A1） -->
        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnReview"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_section"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/reward_review"
            app:icon="@drawable/ic_quiz"
            app:iconGravity="textStart" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 主按钮：完成 -->
        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnDone"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/ls_section"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/reward_done"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />

        <!-- 次按钮：再来一次 -->
        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnAgain"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:minHeight="@dimen/ls_btn_icon"
            android:text="@string/reward_again" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
