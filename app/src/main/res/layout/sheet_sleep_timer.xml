<?xml version="1.0" encoding="utf-8"?>
<!-- §7.11 睡前定时 BottomSheet：睡熊猫 + 10/20/30 选项 + 播完开关 + 开始计时 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/ls_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/ls_stamp"
                android:layout_height="@dimen/ls_stamp"
                android:background="@drawable/bg_circle_yellow">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/home_panda_desc"
                    android:padding="@dimen/ls_gap_sm"
                    android:src="@drawable/ic_panda_sleep" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/st_headline"
                    android:textAppearance="@style/TextAppearance.LS.Headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/st_sub"
                    android:textAppearance="@style/TextAppearance.LS.Caption"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 未计时：选项 + 开关 + 开始计时 -->
        <LinearLayout
            android:id="@+id/setupArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ls_section"
                android:orientation="horizontal">

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/opt1"
                    style="@style/Widget.LS.Block.Option"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ls_sheet_option_h"
                    android:layout_weight="1"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/opt1Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/st_minute_debug"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/opt10"
                    style="@style/Widget.LS.Block.Option"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ls_sheet_option_h"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/opt10Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/opt20"
                    style="@style/Widget.LS.Block.Option"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ls_sheet_option_h"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/opt20Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>

                <com.littlestar.app.core.ui.BlockLayout
                    android:id="@+id/opt30"
                    style="@style/Widget.LS.Block.Option"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ls_sheet_option_h"
                    android:layout_marginStart="@dimen/ls_gap"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/opt30Text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.LS.Body"
                        android:textStyle="bold" />
                </com.littlestar.app.core.ui.BlockLayout>
            </LinearLayout>

            <!-- 开关行 -->
            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/finishRow"
                style="@style/Widget.LS.Block.Parent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_secondary"
                android:layout_marginTop="@dimen/ls_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ls_gap"
                    android:paddingEnd="@dimen/ls_gap">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/st_finish"
                            android:textAppearance="@style/TextAppearance.LS.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/st_finish_sub"
                            android:textAppearance="@style/TextAppearance.LS.Caption" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/finishSwitch"
                        android:layout_width="@dimen/ls_switch_w"
                        android:layout_height="@dimen/ls_switch_h"
                        android:background="@drawable/bg_switch_on">

                        <View
                            android:id="@+id/finishKnob"
                            android:layout_width="@dimen/ls_switch_knob"
                            android:layout_height="@dimen/ls_switch_knob"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/ls_badge_pad"
                            android:layout_marginEnd="@dimen/ls_badge_pad"
                            android:background="@drawable/bg_switch_knob" />
                    </FrameLayout>
                </LinearLayout>
            </com.littlestar.app.core.ui.BlockLayout>

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnStart"
                style="@style/Widget.LS.Block.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_primary"
                android:layout_marginTop="@dimen/ls_section">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/st_start"
                    android:textAppearance="@style/TextAppearance.LS.Button" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>

        <!-- 已在计时：剩余 + 取消计时 -->
        <LinearLayout
            android:id="@+id/runningArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/remainingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ls_section"
                android:textAppearance="@style/TextAppearance.LS.Display" />

            <com.littlestar.app.core.ui.BlockLayout
                android:id="@+id/btnCancelTimer"
                style="@style/Widget.LS.Block.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ls_btn_secondary"
                android:layout_marginTop="@dimen/ls_gap">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/st_cancel_timer"
                    android:textAppearance="@style/TextAppearance.LS.Button"
                    android:textColor="@color/ls_ink" />
            </com.littlestar.app.core.ui.BlockLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ls_gap"
            android:padding="@dimen/ls_gap_sm"
            android:text="@string/st_cancel"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
